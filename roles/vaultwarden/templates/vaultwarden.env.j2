# Managed by Ansible (vaultwarden). Holds secrets: root only.
# Values are single-quoted so Compose reads them literally: Argon2 hashes
# contain "$".
{% if vaultwarden_domain | length > 0 %}
DOMAIN='{{ vaultwarden_domain }}'
{% endif %}
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | bool | lower }}
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | bool | lower }}
WEBSOCKET_ENABLED={{ vaultwarden_websocket_enabled | bool | lower }}
{% if vaultwarden_admin_token | trim | length > 0 %}
ADMIN_TOKEN='{{ vaultwarden_admin_token | trim }}'
CONFIG_FILE_READONLY={{ vaultwarden_admin_config_disabled | bool | lower }}
{% endif %}
{% if vaultwarden_smtp_host | length > 0 %}
SMTP_HOST='{{ vaultwarden_smtp_host }}'
SMTP_PORT={{ vaultwarden_smtp_port }}
SMTP_SECURITY={{ vaultwarden_smtp_security }}
SMTP_FROM='{{ vaultwarden_smtp_from }}'
SMTP_FROM_NAME='{{ vaultwarden_smtp_from_name }}'
{% if vaultwarden_smtp_username | length > 0 %}
SMTP_USERNAME='{{ vaultwarden_smtp_username }}'
SMTP_PASSWORD='{{ vaultwarden_smtp_password | trim }}'
{% endif %}
{% endif %}
{% if vaultwarden_sso_enabled | bool %}
SSO_ENABLED=true
SSO_ONLY={{ vaultwarden_sso_only | bool | lower }}
SSO_AUTHORITY='{{ vaultwarden_sso_authority }}'
SSO_CLIENT_ID='{{ vaultwarden_sso_client_id }}'
SSO_CLIENT_SECRET='{{ vaultwarden_sso_client_secret | trim }}'
SSO_SCOPES='{{ vaultwarden_sso_scopes }}'
SSO_PKCE={{ vaultwarden_sso_pkce | bool | lower }}
SSO_SIGNUPS_MATCH_EMAIL={{ vaultwarden_sso_signups_match_email | bool | lower }}
SSO_AUTH_ONLY_NOT_SESSION={{ vaultwarden_sso_auth_only_not_session | bool | lower }}
{% endif %}
{% for key, value in vaultwarden_environment.items() %}
{{ key }}='{{ value }}'
{% endfor %}
