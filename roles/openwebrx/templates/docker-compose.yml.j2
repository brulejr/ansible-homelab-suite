# Managed by Ansible (openwebrx)
services:
  openwebrx:
    image: "{{ openwebrx_image }}"
    container_name: "{{ openwebrx_container_name }}"
    restart: "{{ openwebrx_restart_policy }}"
    environment:
      TZ: "{{ openwebrx_timezone }}"
      # Creates the user on first start only. "$$" keeps Compose from
      # expanding a "$" in the password.
      OPENWEBRX_ADMIN_USER: "{{ openwebrx_admin_user }}"
      OPENWEBRX_ADMIN_PASSWORD: {{ openwebrx_admin_password | replace('$', '$$') | to_json }}
    volumes:
      - "{{ openwebrx_data_dir }}/etc:/etc/openwebrx"
      - "{{ openwebrx_data_dir }}/var:/var/lib/openwebrx"
      - "{{ openwebrx_data_dir }}/plugins:/usr/lib/python3/dist-packages/htdocs/plugins"
    ports:
      - "{{ openwebrx_bind_ip }}:{{ openwebrx_host_port }}:8073"
{% if openwebrx_device | length > 0 %}
    devices:
      - "{{ openwebrx_device }}:{{ openwebrx_device }}"
{% endif %}
    networks:
      - {{ openwebrx_docker_network }}

networks:
  {{ openwebrx_docker_network }}:
    external: true
