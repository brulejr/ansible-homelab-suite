# Managed by Ansible (linkwarden). Holds secrets: root only.
NEXTAUTH_URL=https://{{ linkwarden_fqdn }}/api/v1/auth
NEXTAUTH_SECRET={{ linkwarden_nextauth_secret | trim }}
DATABASE_URL=postgresql://{{ linkwarden_db_user | urlencode }}:{{ linkwarden_db_password | trim | urlencode | replace('/', '%2F') }}@{{ linkwarden_db_container_name }}:5432/{{ linkwarden_db_name }}
NEXT_PUBLIC_CREDENTIALS_ENABLED={{ linkwarden_credentials_enabled | bool | lower }}
NEXT_PUBLIC_DISABLE_REGISTRATION={{ linkwarden_registration_disabled | bool | lower }}
{% if linkwarden_authelia_enabled | bool %}
NEXT_PUBLIC_AUTHELIA_ENABLED=true
AUTHELIA_CUSTOM_NAME={{ linkwarden_authelia_button_name }}
AUTHELIA_CLIENT_ID={{ linkwarden_authelia_client_id }}
AUTHELIA_CLIENT_SECRET={{ linkwarden_authelia_client_secret | trim }}
AUTHELIA_WELLKNOWN_URL={{ linkwarden_authelia_wellknown_url }}
DISABLE_NEW_SSO_USERS={{ linkwarden_new_sso_users_disabled | bool | lower }}
{% endif %}
{% for key, value in linkwarden_environment.items() %}
{{ key }}={{ value }}
{% endfor %}
