# Managed by Ansible (authelia). Secrets are read from /secrets through the
# AUTHELIA_*_FILE variables in docker-compose.yml.
---
theme: "{{ authelia_theme }}"

server:
  address: "tcp://:{{ authelia_container_port }}/"
  endpoints:
    authz:
      forward-auth:
        implementation: ForwardAuth

log:
  level: "{{ authelia_log_level }}"

totp:
  issuer: "{{ authelia_totp_issuer }}"

webauthn:
  display_name: "{{ authelia_webauthn_display_name }}"

authentication_backend:
  password_reset:
    disable: {{ (not (authelia_password_reset_enabled | bool)) | lower }}
  ldap:
    implementation: lldap
    address: "{{ authelia_ldap_address }}"
    base_dn: "{{ authelia_ldap_base_dn }}"
    user: "{{ authelia_ldap_user }}"

access_control:
  default_policy: "{{ authelia_access_control_default_policy }}"
{% if authelia_access_control_rules | length > 0 %}
  rules:
    {{ authelia_access_control_rules | to_nice_yaml(indent=2) | indent(4) }}
{% endif %}
{% if authelia_oidc_clients | length > 0 %}

# The signing key and client secrets are read from /secrets by Authelia's
# template filter (X_AUTHELIA_CONFIG_FILTERS) when it loads this file.
identity_providers:
  oidc:
    jwks:
      - key: {{ '{{' }} secret "/secrets/oidc_jwks_key" | mindent 10 "|" | msquote {{ '}}' }}
{% set gated = authelia_oidc_clients | selectattr('groups', 'defined') | selectattr('groups') | list %}
{% if gated | length > 0 %}
    authorization_policies:
{% for client in gated %}
      {{ client.id }}:
        default_policy: deny
        rules:
          - policy: {{ client.policy | default(authelia_default_app_policy) | to_json }}
            subject: {{ client.groups | map('regex_replace', '^', 'group:') | list | to_json }}
{% endfor %}
{% endif %}
{% set claimed = authelia_oidc_clients | selectattr('id_token_claims', 'defined') | selectattr('id_token_claims') | list %}
{% if claimed | length > 0 %}
    claims_policies:
{% for client in claimed %}
      {{ client.id }}:
        id_token: {{ client.id_token_claims | to_json }}
{% endfor %}
{% endif %}
    clients:
{% for client in authelia_oidc_clients %}
      - client_id: {{ client.id | to_json }}
        client_name: {{ client.name | default(client.id) | to_json }}
        client_secret: {{ '{{' }} secret "/secrets/oidc_client_{{ client.id }}" | msquote {{ '}}' }}
        public: false
        authorization_policy: {{ (client.id if client in gated else client.policy | default(authelia_default_app_policy)) | to_json }}
{% if client in claimed %}
        claims_policy: {{ client.id | to_json }}
{% endif %}
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris: {{ client.redirect_uris | to_json }}
        scopes: {{ client.scopes | default(['openid', 'email', 'profile']) | to_json }}
        response_types: ["code"]
        grant_types: ["authorization_code"]
        token_endpoint_auth_method: {{ client.token_endpoint_auth_method | default('client_secret_basic') | to_json }}
{% endfor %}
{% endif %}

session:
  expiration: "{{ authelia_session_expiration }}"
  inactivity: "{{ authelia_session_inactivity }}"
  remember_me: "{{ authelia_session_remember_me }}"
  cookies:
    - domain: "{{ authelia_session_domain }}"
      name: "{{ authelia_session_cookie_name }}"
      authelia_url: "https://{{ authelia_fqdn }}"
{% if authelia_default_redirection_url | length > 0 %}
      default_redirection_url: "{{ authelia_default_redirection_url }}"
{% endif %}

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  local:
    path: /config/db.sqlite3

notifier:
{% if authelia_smtp_address | length > 0 %}
  smtp:
    address: "{{ authelia_smtp_address }}"
    username: "{{ authelia_smtp_username }}"
    sender: "{{ authelia_smtp_sender }}"
{% else %}
  filesystem:
    filename: /config/notification.txt
{% endif %}
